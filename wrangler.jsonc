{
  // Deploy: npx wrangler kv namespace create KV  -> copy id vào kv_namespaces bên dưới
  // Sau đó: npx wrangler deploy
  "name": "build",
  "compatibility_date": "2026-10-02",
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "KV", "id": "PASTE_KV_NAMESPACE_ID_HERE" }
  ]
}
